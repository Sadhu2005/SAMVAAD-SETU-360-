# =================================================================
# SAMVAAD-SETU 360° (संवाद सेतु) — Environment Configuration Template
# Project ID: samvaad-setu-360 | Project Number: 507246172982
# NEVER commit real secret values to Git! Fill secrets in AI Studio or local .env only.
# =================================================================

# Server Configuration (Express — server.ts)
PORT=3000
NODE_ENV=production
GEMINI_API_KEY=
# Default model when GEMINI_API_KEY is set (server-side only)
GEMINI_MODEL=gemini-2.5-flash
# Set to false to force rule-based officer desk assist without calling Gemini
GEMINI_ENABLED=true
APP_URL=https://ais-pre-ddptwvkz4i4x6xm32fjel5-669677889121.asia-southeast1.run.app

# Local development: use APP_URL=http://localhost:3000 instead of Cloud Run URL above.

# Firebase Web Client Configuration (Vite — src/config/firebaseClientConfig.ts)
# Copy missing values from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=samvaad-setu-360.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=samvaad-setu-360
VITE_FIREBASE_STORAGE_BUCKET=samvaad-setu-360.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=507246172982
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Leave empty when using Firestore (default) database only:
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Officer Command Desk shared PIN (also set OFFICER_DESK_PIN on the server)
VITE_OFFICER_DESK_PIN=setu-desk-2026
OFFICER_DESK_PIN=setu-desk-2026

# Browser uploads to Firebase Storage need a bucket CORS policy:
#   gsutil cors set docs/security/storage-cors.json gs://samvaad-setu-360.firebasestorage.app
# Leave unset so voice/photo persist as data URLs via /api/v1/tickets/:id/media.
# VITE_FIREBASE_STORAGE_UPLOADS=true
